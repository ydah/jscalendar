    def aliases=: (untyped) -> untyped
    def standard: () -> (Array[TimeZoneRule])?
    def standard=: (untyped) -> untyped
    def daylight: () -> (Array[TimeZoneRule])?
    def daylight=: (untyped) -> untyped
  end
  class TimeZoneRule < Model
    def start: () -> (LocalDateTime)?
    def start=: (untyped) -> untyped
    def offsetFrom: () -> (String)?
    def offsetFrom=: (untyped) -> untyped
    alias offset_from offsetFrom
    alias offset_from= offsetFrom=
    def offsetTo: () -> (String)?
    def offsetTo=: (untyped) -> untyped
    alias offset_to offsetTo
    alias offset_to= offsetTo=
    def recurrenceRules: () -> (Array[RecurrenceRule])?
    def recurrenceRules=: (untyped) -> untyped
    alias recurrence_rules recurrenceRules
    alias recurrence_rules= recurrenceRules=
    def recurrenceOverrides: () -> (Hash[String, object])?
    def recurrenceOverrides=: (untyped) -> untyped
    alias recurrence_overrides recurrenceOverrides
    alias recurrence_overrides= recurrenceOverrides=
    def names: () -> (Hash[String, bool])?
    def names=: (untyped) -> untyped
    def comments: () -> (Array[String])?
    def comments=: (untyped) -> untyped
  end
end

module JSCalendar = Jscalendar
