module Jscalendar
  VERSION: String
  type json_value = nil | bool | Integer | Float | String | Array[json_value] | Hash[String, json_value]
  type object = Hash[String, json_value]
  def self.parse: (String source, ?strict: bool, **Integer limits) -> (Event | Task | Group)
  def self.validate: (String | object source, **Integer limits) -> Array[Violation]
  class Violation < Struct[untyped]
    attr_accessor pointer: String
    attr_accessor message: String
  end
  class Error < StandardError
    attr_reader pointer: String?
  end
  class ParseError < Error
  end
  class ConversionError < Error
  end
  class LimitError < Error
  end
  class UnsupportedError < Error
  end
  class ValidationError < Error
    attr_reader errors: Array[Violation]
  end
  class Model
    attr_reader limits: Hash[Symbol, Integer]
    def self.build: (**untyped properties) ?{ (instance) -> void } -> instance
    def initialize: (?object data, ?strict: bool, ?time_zones: object, **Integer limits) -> void
    def []: (String | Symbol) -> untyped
    def []=: (String | Symbol, untyped) -> untyped
    def key?: (String | Symbol) -> bool
    def delete: (String | Symbol) -> untyped
    def to_h: () -> object
    def to_json: (?Hash[Symbol, untyped]? options) -> String
    def errors: () -> Array[Violation]
    alias warnings errors
    def valid?: () -> bool
    def validate!: () -> self
    def localize: (String) -> instance
  end
  class IdMap[A]
    include Enumerable[[String, A]]
    def []: (String | Symbol) -> A?
    def []=: (String | Symbol, object | A) -> untyped
    def each: () { (String, A) -> void } -> self
            | () -> Enumerator[[String, A], self]
    def keys: () -> Array[String]
    def values: () -> Array[A]
    def size: () -> Integer
    alias length size
    def empty?: () -> bool
    def key?: (String | Symbol) -> bool
    def delete: (String | Symbol) -> A?
    def add: (object | A, ?prefix: String) -> String
    def to_h: () -> object
  end
  class LocalDateTime
    include Comparable
    def initialize: (String | LocalDateTime) -> void
    def self.from_time: (Time) -> LocalDateTime
    def to_s: () -> String
    def to_time: () -> Time
    def <=>: (String | LocalDateTime) -> Integer?
  end
  class Duration
    attr_reader days: Integer
    attr_reader seconds: Rational
    def initialize: (String | Duration) -> void
    def self.from_seconds: (Numeric) -> instance
    def to_s: () -> String
    def to_seconds: () -> Rational
    def add_to: (String | LocalDateTime, ?time_zone: String?, ?time_zones: object) -> LocalDateTime
  end
  class SignedDuration < Duration
  end
  class PatchObject
    def initialize: (object, ?max_patches: Integer, **Integer limits) -> void
    def to_h: () -> object
    def apply: (object, ?validate: bool) -> object
  end
  module RecurringCalendar
    def start_time: (?time_zone: String?) -> Time
    def end_time: (?time_zone: String?) -> Time
    def occurrences: (from: Time, to: Time, ?limit: Integer, ?time_zone: String?, ?timeout: Numeric) -> Occurrences
    def add_recurrence_rule: (**untyped properties) -> self
  end
  class Occurrence
    attr_reader recurrence_id: LocalDateTime
    attr_reader event: Event | Task
    alias calendar event
    def start_time: (?time_zone: String?) -> Time
  end
  class Occurrences
    include Enumerable[Occurrence]
    def each: () { (Occurrence) -> void } -> self
            | () -> Enumerator[Occurrence, self]
    def truncated?: () -> bool
  end
